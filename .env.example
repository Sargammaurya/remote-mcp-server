# Bruin MCP service settings. Copy to .env (never commit .env) and load with:
#   set -a; . ./.env; set +a
# All paths must be absolute. Replace /srv/bruin-mcp-service with wherever
# this project is checked out. No secrets belong in this file's example values.

# dev | prod — dev refuses any non-loopback bind address
BMCP_ENV=dev
BMCP_BIND_HOST=127.0.0.1
BMCP_PORT=18443
# the URL clients connect to (without /mcp). It is checked against the Host
# header and is the OAuth resource id. dev: must be loopback; prod: must be https.
BMCP_PUBLIC_URL=http://127.0.0.1:18443

# per-user data lives under <BMCP_WORKSPACE_ROOT>/users/<user_id>/
BMCP_WORKSPACE_ROOT=/srv/bruin-mcp-service/var/dev-workspace
BMCP_LOG_DIR=/srv/bruin-mcp-service/var/logs
# per-call scratch (Bruin query dirs); emptied of leftovers at startup
BMCP_TMP_DIR=/srv/bruin-mcp-service/var/tmp
# bearer tokens (hashes only), mode 0600; manage with `python -m bruin_mcp_service.admin`
BMCP_TOKEN_FILE=/srv/bruin-mcp-service/var/auth/tokens.json

# pinned Bruin release, checked offline against VERIFIED.txt before every run
BRUIN_BIN=/srv/bruin-mcp-service/vendor/bruin/v0.11.780/bruin
BRUIN_VERIFIED_FILE=/srv/bruin-mcp-service/vendor/bruin/v0.11.780/VERIFIED.txt
BRUIN_EXPECTED_VERSION=v0.11.780
# HOME given to Bruin; it creates .bruin/, caches and .config/adbc/ underneath
BRUIN_HOME=/srv/bruin-mcp-service/var/bruin-home

# Bruin telemetry opt-out (documented: getbruin.com/docs/bruin/getting-started/telemetry).
# bruin_cli.py always sets this for Bruin itself; it is here so a manual
# `bruin` run from a shell that loaded this file is opted out too.
TELEMETRY_OPTOUT=true

# limits
BMCP_MAX_UPLOAD_MB=100
BMCP_MAX_EXPORT_MB=100
# proposed initial per-user quota, subject to disk monitoring and review
BMCP_USER_QUOTA_GB=5
BMCP_ALLOWED_INPUT_EXT=.csv,.xlsx
# seconds per tool call; concurrent calls per user and in total (extra calls are refused, not queued)
BMCP_TOOL_TIMEOUT_S=120
BMCP_USER_CONCURRENCY=2
BMCP_MAX_CONCURRENCY=8
# pipeline runs: wall-clock limit per run, and runs at once across all users
BMCP_RUN_TIMEOUT_S=600
BMCP_MAX_RUNS=2
# DEBUG | INFO | WARNING | ERROR
BMCP_LOG_LEVEL=INFO
